{
  "name": "generator-springboot",
  "version": "0.3.0",
  "description": "A Yeoman generator for generating SpringBoot microservices",
  "keywords": [
    "yeoman-generator",
    "java",
    "spring",
    "spring-boot",
    "microservice"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chensoul/generator-springboot"
  },
  "author": "chensoul <ichensoul@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chensoul/generator-springboot/issues"
  },
  "homepage": "https://github.com/chensoul/generator-springboot",
  "files": [
    "generators"
  ],
  "main": "generators/app/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:unit -- \"test/**/*.spec.js\" \"test/*.spec.js\" --no-insight",
    "test:unit": "mocha --timeout 120000 --slow 0 --reporter spec",
    "lint": "eslint generators/ test/ --max-warnings 0",
    "format": "prettier --write generators/ test/ eslint.config.js"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "lodash": "^4.18.1",
    "shelljs": "^0.10.0",
    "yeoman-environment": "^6.1.0",
    "yeoman-generator": "^8.2.2"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.4.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "sinon": "^19.0.5",
    "yeoman-assert": "^3.1.1",
    "yeoman-test": "^11.6.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
